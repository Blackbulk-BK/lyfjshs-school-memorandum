# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your website address (use http://localhost:3000 while testing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail used to SEND the memorandum emails
# Needs 2-Step Verification ON, then create an "App Password"
GMAIL_USER=school.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The built-in email that ALWAYS receives every shared memorandum
MEMO_DEFAULT_RECIPIENT=school.inbox@gmail.com
