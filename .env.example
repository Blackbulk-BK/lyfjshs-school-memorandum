# These same names are used on your computer (.env) AND on Vercel (Settings > Environment Variables)

# ---------- Supabase (Project Settings > API Keys) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ---------- Inbox that ALWAYS gets a copy of every shared memorandum ----------
MEMO_DEFAULT_RECIPIENT=school.email@gmail.com

# ---------- Sending emails with Brevo (free: 300 emails per day) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Your Brevo SMTP login (shown on Brevo > SMTP & API > SMTP)
SMTP_USER=your-brevo-login
# The SMTP key from Brevo (NOT your Brevo password)
SMTP_PASS=xsmtpsib-xxxxxxxxxxxxxxxx
# A sender address you verified in Brevo
MAIL_FROM=school.email@gmail.com

# ---------- Optional ----------
# Only needed if the website address is not detected correctly.
# Do NOT set it to localhost on Vercel.
# SITE_URL=https://your-site.vercel.app
# MAX_RECIPIENTS=290
